# Configuración de entorno · Puerto Delta (Reto 1)
# Copiar a .env para desarrollo local. Nunca subir .env al repositorio.

DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion-o-demo-de-red-50-caracteres-min
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Si se define DATABASE_URL, se usa PostgreSQL (ej. postgresql://postgres:postgres@127.0.0.1:5432/puerto_delta).
# Si se deja vacío, se usa SQLite local (backend/db.sqlite3) para contingencia de demo individual.
DATABASE_URL=

# Cookies seguras (activar a 1 solo cuando se sirva detrás de HTTPS en red)
DJANGO_SECURE_COOKIES=0
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Contraseñas de cuentas de demostración creadas por `manage.py seed_demo_users`
DEMO_PASSWORD_CONSULTA=delta-consulta-2026
DEMO_PASSWORD_OPERADOR=delta-operador-2026
DEMO_PASSWORD_VALIDADOR=delta-validador-2026
